<Window x:Class="VlessVpnClient.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="720" Height="700"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock Style="{StaticResource HeaderText}" FontSize="18" Text="Настройки" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                           Text="Параметры подключения, тема и поведение приложения" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheaderText}" Text="Подключение" Margin="0,0,0,12" />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Режим прокси" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="ProxyModeBox" MaxWidth="320" HorizontalAlignment="Left" MinWidth="240">
                                <ComboBoxItem Content="Системный прокси (HTTP/SOCKS)" />
                                <ComboBoxItem Content="Только прослушивание (вручную)" />
                            </ComboBox>
                        </Grid>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="6" Padding="14,10" Margin="0,16,0,0">
                            <StackPanel>
                                <CheckBox x:Name="EnableHttpBox" Content="HTTP inbound" />
                                <Grid Margin="28,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="HTTP порт" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBox Grid.Column="1" x:Name="HttpPortBox" MaxWidth="120" HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="6" Padding="14,10" Margin="0,8,0,0">
                            <StackPanel>
                                <CheckBox x:Name="EnableSocksBox" Content="SOCKS inbound" />
                                <Grid Margin="28,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SOCKS порт" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBox Grid.Column="1" x:Name="SocksPortBox" MaxWidth="120" HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="BypassLanBox" Margin="0,16,0,0"
                                  Content="Не использовать прокси для локальных адресов (LAN)" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheaderText}" Text="Запуск" Margin="0,0,0,12" />
                        <CheckBox x:Name="AutoStartBox" Content="Запускать вместе с Windows" />
                        <CheckBox x:Name="StartMinimizedBox" Content="Запускать свёрнутым в трей" />
                        <CheckBox x:Name="ConnectOnStartBox" Content="Автоматически подключаться к последнему серверу при старте" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheaderText}" Text="Интерфейс и логи" Margin="0,0,0,12" />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Тема" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="ThemeBox" MinWidth="240" MaxWidth="320" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Тёмная" />
                                <ComboBoxItem Content="Светлая" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Уровень лога xray" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="LogLevelBox" MinWidth="240" MaxWidth="320" HorizontalAlignment="Left">
                                <ComboBoxItem Content="debug" />
                                <ComboBoxItem Content="info" />
                                <ComboBoxItem Content="warning" />
                                <ComboBoxItem Content="error" />
                                <ComboBoxItem Content="none" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheaderText}" Text="Тест пинга" Margin="0,0,0,12" />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="URL для real-delay" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="PingUrlBox" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Таймаут (мс)" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="PingTimeoutBox" MaxWidth="120" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheaderText}" Text="Подписки" Margin="0,0,0,12" />
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="User-Agent" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="UserAgentBox" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" MinWidth="100" Margin="0,0,8,0" />
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinWidth="120" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
