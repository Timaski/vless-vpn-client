<Window x:Class="VlessVpnClient.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="640" Height="640"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Width="100" Margin="0,0,8,0" />
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" Width="120" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Подключение" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Режим прокси:" Width="180" VerticalAlignment="Center" />
                    <ComboBox x:Name="ProxyModeBox" Width="200">
                        <ComboBoxItem Content="Системный прокси (HTTP/SOCKS)" />
                        <ComboBoxItem Content="Только прослушивание (вручную)" />
                    </ComboBox>
                </StackPanel>

                <CheckBox x:Name="EnableHttpBox" Content="HTTP inbound" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="HTTP порт:" Width="160" VerticalAlignment="Center" />
                    <TextBox x:Name="HttpPortBox" Width="100" />
                </StackPanel>

                <CheckBox x:Name="EnableSocksBox" Content="SOCKS inbound" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="SOCKS порт:" Width="160" VerticalAlignment="Center" />
                    <TextBox x:Name="SocksPortBox" Width="100" />
                </StackPanel>

                <CheckBox x:Name="BypassLanBox" Content="Не использовать прокси для локальных адресов (LAN)" Margin="0,8,0,0" />

                <Separator Margin="0,16" Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="Запуск" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                <CheckBox x:Name="AutoStartBox" Content="Запускать вместе с Windows" />
                <CheckBox x:Name="StartMinimizedBox" Content="Запускать свёрнутым в трей" />
                <CheckBox x:Name="ConnectOnStartBox" Content="Автоматически подключаться к последнему серверу при старте" />

                <Separator Margin="0,16" Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="Интерфейс и логи" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Тема:" Width="180" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeBox" Width="200">
                        <ComboBoxItem Content="Тёмная" />
                        <ComboBoxItem Content="Светлая" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Уровень лога xray:" Width="180" VerticalAlignment="Center" />
                    <ComboBox x:Name="LogLevelBox" Width="200">
                        <ComboBoxItem Content="debug" />
                        <ComboBoxItem Content="info" />
                        <ComboBoxItem Content="warning" />
                        <ComboBoxItem Content="error" />
                        <ComboBoxItem Content="none" />
                    </ComboBox>
                </StackPanel>

                <Separator Margin="0,16" Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="Тест пинга" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="URL для real-delay:" Width="180" VerticalAlignment="Center" />
                    <TextBox x:Name="PingUrlBox" Width="380" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Таймаут (мс):" Width="180" VerticalAlignment="Center" />
                    <TextBox x:Name="PingTimeoutBox" Width="100" />
                </StackPanel>

                <Separator Margin="0,16" Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="Подписки" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="User-Agent:" Width="180" VerticalAlignment="Center" />
                    <TextBox x:Name="UserAgentBox" Width="380" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
