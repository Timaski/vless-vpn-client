<Window x:Class="VlessVpnClient.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TYU HUB :: CONFIG"
        Width="720" Height="700"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{DynamicResource MonoFont}"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PromptText}" Text="&gt; " />
                    <TextBlock Style="{StaticResource HeaderText}" FontSize="18" Text="CONFIG" />
                </StackPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                           Text="// connection, runtime and feed parameters" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheaderText}" Text="// LINK" Margin="0,0,0,12" />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="proxy mode" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="ProxyModeBox" MaxWidth="320" HorizontalAlignment="Left" MinWidth="240">
                                <ComboBoxItem Content="system proxy (HTTP/SOCKS)" />
                                <ComboBoxItem Content="listen only (manual)" />
                            </ComboBox>
                        </Grid>

                        <Border Background="{DynamicResource SurfaceAltBrush}" Padding="14,10" Margin="0,14,0,0">
                            <StackPanel>
                                <CheckBox x:Name="EnableHttpBox" Content="HTTP inbound" />
                                <Grid Margin="30,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="HTTP port" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBox Grid.Column="1" x:Name="HttpPortBox" MaxWidth="120" HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceAltBrush}" Padding="14,10" Margin="0,8,0,0">
                            <StackPanel>
                                <CheckBox x:Name="EnableSocksBox" Content="SOCKS inbound" />
                                <Grid Margin="30,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SOCKS port" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBox Grid.Column="1" x:Name="SocksPortBox" MaxWidth="120" HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="BypassLanBox" Margin="0,14,0,0"
                                  Content="bypass LAN addresses" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheaderText}" Text="// BOOT" Margin="0,0,0,12" />
                        <CheckBox x:Name="AutoStartBox" Content="autostart on Windows boot" />
                        <CheckBox x:Name="StartMinimizedBox" Content="start minimized to tray" />
                        <CheckBox x:Name="ConnectOnStartBox" Content="auto-dial last node on launch" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheaderText}" Text="// DISPLAY" Margin="0,0,0,12" />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="theme" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="ThemeBox" MinWidth="240" MaxWidth="320" HorizontalAlignment="Left">
                                <ComboBoxItem Content="phosphor green (dark)" />
                                <ComboBoxItem Content="amber (light)" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="xray log level" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="LogLevelBox" MinWidth="240" MaxWidth="320" HorizontalAlignment="Left">
                                <ComboBoxItem Content="debug" />
                                <ComboBoxItem Content="info" />
                                <ComboBoxItem Content="warning" />
                                <ComboBoxItem Content="error" />
                                <ComboBoxItem Content="none" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheaderText}" Text="// PROBE" Margin="0,0,0,12" />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="real-delay URL" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="PingUrlBox" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="timeout (ms)" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="PingTimeoutBox" MaxWidth="120" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheaderText}" Text="// FEEDS" Margin="0,0,0,12" />
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="user-agent" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="UserAgentBox" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="[ CANCEL ]" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"
                        MinWidth="110" Margin="0,0,8,0" />
                <Button Content="[ SAVE ]" Style="{StaticResource PrimaryButton}" Click="Save_Click"
                        MinWidth="120" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
