<Window x:Class="VlessVpnClient.App.Views.SubscriptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подписки"
        Width="700" Height="420"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="SubsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                <DataGridTextColumn Header="Серверов" Binding="{Binding LastFetchedCount}" Width="100" />
                <DataGridTextColumn Header="Обновлено" Binding="{Binding LastUpdated, StringFormat=g}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="Remove_Click" Width="120" Margin="0,0,8,0" />
            <Button Content="Закрыть" Style="{StaticResource PrimaryButton}" Click="Close_Click" Width="120" />
        </StackPanel>
    </Grid>
</Window>
