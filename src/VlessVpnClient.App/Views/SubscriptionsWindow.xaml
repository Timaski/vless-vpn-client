<Window x:Class="VlessVpnClient.App.Views.SubscriptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подписки"
        Width="780" Height="480"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock Style="{StaticResource HeaderText}" FontSize="18" Text="Подписки" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                           Text="Управление источниками подписок и серверами, добавленными из них" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="20"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid x:Name="SubsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ИМЯ" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                    <DataGridTextColumn Header="СЕРВЕРОВ" Binding="{Binding LastFetchedCount}" Width="100" />
                    <DataGridTextColumn Header="ОБНОВЛЕНО" Binding="{Binding LastUpdated, StringFormat=g}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Click="Remove_Click" MinWidth="120" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;"
                                   Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="Удалить" Margin="8,0,0,0"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                </Button>
                <Button Content="Закрыть" Style="{StaticResource PrimaryButton}" Click="Close_Click" MinWidth="120" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
