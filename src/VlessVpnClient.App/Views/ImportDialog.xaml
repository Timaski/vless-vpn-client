<Window x:Class="VlessVpnClient.App.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт VLESS / подписки"
        Width="680" Height="520"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock Style="{StaticResource HeaderText}" FontSize="18" Text="Импорт сервера" />
                <TextBlock Style="{StaticResource MutedText}"
                           Margin="0,4,0,0"
                           Text="Вставьте vless:// URL, ссылку на подписку или содержимое подписки" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource SectionLabel}" Text="ТИП ИСТОЧНИКА" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="ModeVless" Content="vless:// URL" IsChecked="True" Margin="0,0,24,0" />
                <RadioButton x:Name="ModeSubUrl" Content="URL подписки" Margin="0,0,24,0" />
                <RadioButton x:Name="ModeSubText" Content="Содержимое подписки" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Visibility="{Binding ElementName=ModeSubUrl, Path=IsChecked, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,12">
                <TextBlock Style="{StaticResource SectionLabel}" Text="ИМЯ ПОДПИСКИ" />
                <TextBox x:Name="SubscriptionName" />
            </StackPanel>

            <Border Grid.Row="3"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBox x:Name="InputBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         FontSize="12"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12" />
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="4"
                       Style="{StaticResource MutedText}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" MinWidth="100" Margin="0,0,8,0" />
                <Button Content="Импортировать" Style="{StaticResource PrimaryButton}" Click="Ok_Click" MinWidth="140" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
