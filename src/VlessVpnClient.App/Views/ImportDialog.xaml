<Window x:Class="VlessVpnClient.App.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TYU HUB :: IMPORT"
        Width="680" Height="520"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{DynamicResource MonoFont}"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PromptText}" Text="&gt; " />
                    <TextBlock Style="{StaticResource HeaderText}" FontSize="18" Text="IMPORT NODE" />
                </StackPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                           Text="// vless:// URL  ::  subscription URL  ::  raw subscription text" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource SectionLabel}" Text="// SOURCE TYPE" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="ModeVless" Content="vless:// URL" IsChecked="True" Margin="0,0,24,0" />
                <RadioButton x:Name="ModeSubUrl" Content="subscription URL" Margin="0,0,24,0" />
                <RadioButton x:Name="ModeSubText" Content="subscription text" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Visibility="{Binding ElementName=ModeSubUrl, Path=IsChecked, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,10">
                <TextBlock Style="{StaticResource SectionLabel}" Text="// FEED NAME" />
                <TextBox x:Name="SubscriptionName" />
            </StackPanel>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                <TextBox x:Name="InputBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource MonoFont}"
                         FontSize="12"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12" />
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="4"
                       Style="{StaticResource MutedText}"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="[ CANCEL ]" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"
                        MinWidth="110" Margin="0,0,8,0" />
                <Button Content="[ EXEC ]" Style="{StaticResource PrimaryButton}" Click="Ok_Click"
                        MinWidth="140" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
