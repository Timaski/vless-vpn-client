<Window x:Class="VlessVpnClient.App.Views.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TYU HUB :: LOGS"
        Width="900" Height="560"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{DynamicResource MonoFont}"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource PromptText}" Text="&gt; " />
                        <TextBlock Style="{StaticResource HeaderText}" FontSize="18" Text="LOGS" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="// live output of app and xray-core" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click"
                            Margin="0,0,8,0" Content="[ FOLDER ]" />
                    <Button Style="{StaticResource SecondaryButton}" Click="Clear_Click"
                            Content="[ CLEAR ]" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="20" Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     FontFamily="{DynamicResource MonoFont}"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="14" />
        </Border>
    </Grid>
</Window>
