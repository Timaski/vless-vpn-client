<Window x:Class="VlessVpnClient.App.Views.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Логи"
        Width="800" Height="500"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Открыть папку логов" Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" Margin="0,0,8,0" />
            <Button Content="Очистить буфер" Style="{StaticResource SecondaryButton}" Click="Clear_Click" />
        </StackPanel>

        <TextBox x:Name="LogBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 FontFamily="Consolas, Cascadia Code, Courier New"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
    </Grid>
</Window>
