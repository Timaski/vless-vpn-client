<Application x:Class="VlessVpnClient.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VlessVpnClient.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
            <conv:NullToBoolConverter x:Key="NullToBool" />
            <conv:NullToBoolConverter x:Key="NotNullToBool" Invert="False" />
            <conv:LatencyToBrushConverter x:Key="LatencyToBrush" />
            <conv:ConnectionStatusBrushConverter x:Key="ConnectionStatusBrush" />
            <conv:ConnectionStatusTextConverter x:Key="ConnectionStatusText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
