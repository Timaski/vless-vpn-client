<Window x:Class="VlessVpnClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="TYU HUB"
        Width="1080" Height="720"
        MinWidth="820" MinHeight="520"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{DynamicResource MonoFont}"
        FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="Tray"
                        IconSource="/Resources/app.ico"
                        ToolTipText="TYU HUB"
                        TrayMouseDoubleClick="Tray_MouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Показать окно" Click="MenuShow_Click" />
                    <Separator />
                    <MenuItem x:Name="TrayConnectMenu" Header="Подключить" Click="MenuConnect_Click" />
                    <MenuItem x:Name="TrayDisconnectMenu" Header="Отключить" Click="MenuDisconnect_Click" />
                    <Separator />
                    <MenuItem Header="Выход" Click="MenuExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Top terminal header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/app.ico" Width="32" Height="32" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PromptText}" Text="&gt; " />
                            <TextBlock Text="TYU HUB"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="16" FontWeight="Bold" />
                            <TextBlock Text=" v1.0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="13" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="VLESS GATEWAY :: xray-core" />

                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Click="OnLogsClick"
                            Padding="12,6"
                            ToolTip="Открыть логи"
                            Content="[ ЛОГИ ]" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Click="OnSettingsClick"
                            Margin="6,0,0,0"
                            Padding="12,6"
                            ToolTip="Открыть настройки"
                            Content="[ НАСТРОЙКИ ]" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Hero status panel -->
            <Border Grid.Row="0" Style="{StaticResource HeroCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource HeroConnectButton}"
                            Click="OnHeroToggleClick"
                            ToolTip="Подключить / отключить"
                            VerticalAlignment="Center">
                        <Grid>
                            <StackPanel Visibility="{Binding Connection.IsConnected, Converter={StaticResource InvertedBoolToVisibility}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="[ ПОДКЛЮЧИТЬ ]"
                                           FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="нажмите для вызова"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           FontSize="11" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="[ ОТКЛЮЧИТЬ ]"
                                           FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="тоннель активен"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           FontSize="11" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Status block -->
                    <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PromptText}" Text="СТАТУС: " />
                            <TextBlock Text="["
                                       Style="{StaticResource SubheaderText}"
                                       Foreground="{Binding Connection.IsConnected, Converter={StaticResource ConnectionStatusBrush}}" />
                            <TextBlock Text="{Binding Connection.IsConnected, Converter={StaticResource ConnectionStatusText}}"
                                       Style="{StaticResource SubheaderText}"
                                       Foreground="{Binding Connection.IsConnected, Converter={StaticResource ConnectionStatusBrush}}" />
                            <TextBlock Text="]"
                                       Style="{StaticResource SubheaderText}"
                                       Foreground="{Binding Connection.IsConnected, Converter={StaticResource ConnectionStatusBrush}}" />
                            <TextBlock x:Name="BlinkCursor" Text="_"
                                       Style="{StaticResource SubheaderText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="6,0,0,0">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.5"
                                                                 AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource MutedText}"
                                   Text="{Binding StatusMessage, FallbackValue='Нет активного подключения'}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11"
                                   Text="{Binding Connection.ActiveProfile.DisplayName, StringFormat='сервер :: {0}', FallbackValue=''}" />
                    </StackPanel>

                    <!-- Stats -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource SectionLabel}"
                                   HorizontalAlignment="Right"
                                   Text="// СИСТЕМА" />
                        <Grid HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                <TextBlock Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding Profiles.Count, StringFormat={}{0:000}}"
                                           FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="СЕРВЕРЫ"
                                           Style="{StaticResource SectionLabel}"
                                           Margin="0"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding Subscriptions.Count, StringFormat={}{0:000}}"
                                           FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="ПОДПИСКИ"
                                           Style="{StaticResource SectionLabel}"
                                           Margin="0"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toolbar -->
            <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}"
                                Click="OnImportClick"
                                Margin="0,0,8,0"
                                Content="[ + ИМПОРТ ]" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="OnSubscriptionsClick"
                                Margin="0,0,8,0"
                                ToolTip="Управление подписками"
                                Content="[ ПОДПИСКИ ]" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshSubscriptionsCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Обновить все подписки"
                                Content="[ ОБНОВИТЬ ]" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding PingAllCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Замерить пинг всех серверов"
                                Content="[ ПИНГ ]" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="OnSortByLatencyClick"
                                Margin="0,0,8,0"
                                ToolTip="Сортировать по пингу"
                                Content="[ СОРТ ]" />
                        <Button Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteProfileCommand}"
                                ToolTip="Удалить выбранный сервер"
                                Content="[ УДАЛИТЬ ]" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Server list -->
            <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="ProfilesGrid"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="ProfilesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="Bold"
                                                   Text="*"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ИМЯ" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="АДРЕС" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Address}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="СЕТЬ" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Network}"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ШИФР" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Security}"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ПИНГ" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LatencyText}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding LatencyValue, Converter={StaticResource LatencyToBrush}}"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontFamily="{DynamicResource MonoFont}"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   FontSize="14"
                                   HorizontalAlignment="Center">
<Run Text="+----------------------------+" />
<LineBreak/>
<Run Text="|       СЕРВЕРОВ НЕТ        |" />
<LineBreak/>
<Run Text="|       ждём ввода ...      |" />
<LineBreak/>
<Run Text="+----------------------------+" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,18,0,0"
                                   Text="вставьте vless:// URL или подписку через [ + ИМПОРТ ]"
                                   HorizontalAlignment="Center" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Click="OnImportClick"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                Content="[ + ДОБАВИТЬ СЕРВЕР ]" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource AccentBrush}"
                               FontSize="11" FontWeight="Bold" Text="$ " />
                    <TextBlock Style="{StaticResource MutedText}"
                               FontSize="11"
                               Text="{Binding StatusMessage, FallbackValue='готов.'}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="HTTP=127.0.0.1:" />
                    <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"
                               Text="{Binding Settings.HttpInboundPort}" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Text=" :: SOCKS=127.0.0.1:" />
                    <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"
                               Text="{Binding Settings.SocksInboundPort}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
