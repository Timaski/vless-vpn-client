<Window x:Class="VlessVpnClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="VLESS VPN Client"
        Width="1080" Height="720"
        MinWidth="820" MinHeight="520"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="Tray"
                        IconSource="/Resources/app.ico"
                        ToolTipText="VLESS VPN Client"
                        TrayMouseDoubleClick="Tray_MouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Показать окно" Click="MenuShow_Click" />
                    <Separator />
                    <MenuItem x:Name="TrayConnectMenu" Header="Подключить" Click="MenuConnect_Click" />
                    <MenuItem x:Name="TrayDisconnectMenu" Header="Отключить" Click="MenuDisconnect_Click" />
                    <Separator />
                    <MenuItem Header="Выход" Click="MenuExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Top app bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="V"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VLESS VPN Client" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="xray-core · WPF" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}"
                            Click="OnLogsClick"
                            ToolTip="Логи">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7C3;" />
                            <TextBlock Text="Логи" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            Click="OnSettingsClick"
                            Margin="4,0,0,0"
                            ToolTip="Настройки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE713;" />
                            <TextBlock Text="Настройки" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Hero card -->
            <Border Grid.Row="0" Style="{StaticResource HeroCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Hero connect button -->
                    <Button Grid.Column="0"
                            Style="{StaticResource HeroConnectButton}"
                            Click="OnHeroToggleClick"
                            ToolTip="Подключить / отключить"
                            VerticalAlignment="Center">
                        <Grid>
                            <StackPanel Visibility="{Binding Connection.IsConnected, Converter={StaticResource InvertedBoolToVisibility}}">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="44"
                                           Text="&#xE7E8;"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Connect"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.95" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="44"
                                           Text="&#xE73B;"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Disconnect"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.95" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Status -->
                    <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{Binding Connection.IsConnected, Converter={StaticResource ConnectionStatusBrush}}" />
                            <TextBlock Margin="10,0,0,0"
                                       Text="{Binding Connection.IsConnected, Converter={StaticResource ConnectionStatusText}}"
                                       Style="{StaticResource SubheaderText}" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MutedText}"
                                   Text="{Binding StatusMessage, FallbackValue='Нет активного подключения'}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11"
                                   Text="{Binding Connection.ActiveProfile.DisplayName, StringFormat='Сервер: {0}', FallbackValue=''}" />
                    </StackPanel>

                    <!-- Quick stats -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource SectionLabel}"
                                   HorizontalAlignment="Right"
                                   Text="ВСЕГО" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{Binding Profiles.Count}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="серверов"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Subscriptions.Count}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="подписок"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toolbar -->
            <Border Grid.Row="1" Margin="0,16,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}"
                                Click="OnImportClick"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" Foreground="White" />
                                <TextBlock Text="Импорт" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="OnSubscriptionsClick"
                                Margin="0,0,8,0"
                                ToolTip="Управление подписками">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74C;" />
                                <TextBlock Text="Подписки" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshSubscriptionsCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Обновить все подписки">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" />
                                <TextBlock Text="Обновить" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding PingAllCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Замерить пинг для всех серверов">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE968;" />
                                <TextBlock Text="Тест пинга" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="OnSortByLatencyClick"
                                Margin="0,0,8,0"
                                ToolTip="Сортировать по пингу">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8CB;" />
                                <TextBlock Text="Сортировать" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding DeleteProfileCommand}"
                                ToolTip="Удалить выбранный сервер"
                                Foreground="{DynamicResource DangerBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;"
                                           Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="Удалить" Margin="8,0,0,0"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Server list -->
            <Border Grid.Row="2" Margin="0,16,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0">
                <Grid>
                    <DataGrid x:Name="ProfilesGrid"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="ProfilesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="8" Height="8" CornerRadius="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SuccessBrush}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ИМЯ" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="АДРЕС" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Address}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="СЕТЬ" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="4" Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Network}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="БЕЗОПАСНОСТЬ" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="4" Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Security}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ПИНГ" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    Background="{Binding LatencyValue, Converter={StaticResource LatencyToBrush}}" />
                                            <TextBlock Text="{Binding LatencyText}"
                                                       VerticalAlignment="Center"
                                                       FontVariantNumeric="Tabular" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="56"
                                   Text="&#xE968;"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource SubheaderText}"
                                   Margin="0,16,0,0"
                                   Text="Нет добавленных серверов"
                                   HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0"
                                   Text="Нажмите «Импорт» и вставьте vless:// URL или подписку"
                                   HorizontalAlignment="Center" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Click="OnImportClick"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" Foreground="White" />
                                <TextBlock Text="Добавить сервер" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource MutedText}"
                           Text="{Binding StatusMessage, FallbackValue='Готов'}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MutedText}"
                               FontSize="11"
                               Text="HTTP 127.0.0.1:" />
                    <TextBlock Style="{StaticResource MutedText}"
                               FontSize="11"
                               Text="{Binding Settings.HttpInboundPort}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               FontSize="11"
                               Text="  ·  SOCKS 127.0.0.1:" />
                    <TextBlock Style="{StaticResource MutedText}"
                               FontSize="11"
                               Text="{Binding Settings.SocksInboundPort}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
